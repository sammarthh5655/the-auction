# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# Solo mode works without any of this; online rooms need it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Use the local Firebase emulators instead (npm run emulators). Needs Java 11+.
# VITE_FIREBASE_EMULATORS=true
